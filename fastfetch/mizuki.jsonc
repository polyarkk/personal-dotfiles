{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "C:/Users/17811/.config/fastfetch/images/mizuki.jpg",
        "type": "iterm",
        "width": 20,
        "padding": {
            "top": 3,
            "left": 6,
            "right": 8
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
        "break",
        {
            "type": "title",
            "keyWidth": 10
        },
        "break",
        {
            "type": "os",
            "key": "OS  ",
            "keyColor": "38;2;221;170;204",
        },
        {
            "type": "kernel",
            "key": "KER ",
            "keyColor": "38;2;221;170;204",
        },
        {
            "type": "terminal",
            "key": "TER ",
            "keyColor": "38;2;221;170;204", 
        },
        {
            "type": "shell",
            "key": "SH  ",
            "keyColor": "38;2;221;170;204", 
        },
        {
            "type": "wm",
            "key": "WM  ",
            "keyColor": "38;2;221;170;204", 
        },
        {
            "type": "uptime",
            "key": "UP  ",
            "keyColor": "38;2;221;170;204", 
        },
        {
            "type": "memory",
            "key": "MEM ",
            "keyColor": "38;2;221;170;204", 
            "format": "{used} / {total}"
        },
        "break",
        "break",
        "break",
    ]
}
