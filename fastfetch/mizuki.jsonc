// execute with: fastfetch --colors-block-range-start 9 --colors-block-width 3

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/images/mizuki.jpg",
        "type": "sixel",
        "width": 20,
        "padding": {
            "top": 4,
            "left": 6,
            "right": 10
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
        "break",
        {
            "type": "title",
            "keyWidth": 10
        },
        "break",
        {
            "type": "os",
            "key": "OS  ",
            "keyColor": "96",  // = color3
        },
        {
            "type": "kernel",
            "key": "KER ",
            "keyColor": "96",
        },
        {
            "type": "packages",
            "key": "PKG ",
            "keyColor": "96",  
        },
        {
            "type": "terminal",
            "key": "TER ",
            "keyColor": "96", 
        },
        {
            "type": "shell",
            "key": "SH  ",
            "keyColor": "96", 
        },
        {
            "type": "wm",
            "key": "WM  ",
            "keyColor": "96", 
        },
        {
            "type": "uptime",
            "key": "UP  ",
            "keyColor": "96", 
        },
        "break",
        "break",
        "break",
    ]
}
